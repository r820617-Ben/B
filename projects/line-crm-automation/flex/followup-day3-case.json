{
  "type": "flex",
  "altText": "跟你狀況接近的一個案例",
  "contents": {
    "type": "bubble",
    "size": "mega",
    "styles": {
      "body": { "backgroundColor": "#0E1116" },
      "footer": { "backgroundColor": "#0E1116" }
    },
    "hero": {
      "type": "image",
      "url": "{{case_image_url}}",
      "size": "full",
      "aspectRatio": "20:11",
      "aspectMode": "cover"
    },
    "body": {
      "type": "box",
      "layout": "vertical",
      "paddingAll": "20px",
      "contents": [
        { "type": "text", "text": "CASE　{{case_industry}}", "size": "xxs", "color": "#8A8F98", "letterSpacing": "2px" },
        { "type": "text", "text": "{{case_title}}", "size": "lg", "color": "#E8EAED", "weight": "bold", "margin": "sm", "wrap": true },
        { "type": "text", "text": "{{case_summary}}", "size": "sm", "color": "#8A8F98", "margin": "md", "wrap": true, "lineSpacing": "6px" },
        { "type": "separator", "margin": "lg", "color": "#242A31" },
        {
          "type": "box",
          "layout": "horizontal",
          "margin": "lg",
          "contents": [
            {
              "type": "box",
              "layout": "vertical",
              "contents": [
                { "type": "text", "text": "{{metric_1_value}}", "size": "xl", "color": "#C8A96A", "weight": "bold" },
                { "type": "text", "text": "{{metric_1_label}}", "size": "xxs", "color": "#6B7280", "margin": "xs" }
              ]
            },
            {
              "type": "box",
              "layout": "vertical",
              "contents": [
                { "type": "text", "text": "{{metric_2_value}}", "size": "xl", "color": "#C8A96A", "weight": "bold" },
                { "type": "text", "text": "{{metric_2_label}}", "size": "xxs", "color": "#6B7280", "margin": "xs" }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "box",
      "layout": "vertical",
      "paddingAll": "20px",
      "paddingTop": "0px",
      "spacing": "sm",
      "contents": [
        {
          "type": "button",
          "style": "primary",
          "height": "sm",
          "color": "#C8A96A",
          "action": { "type": "postback", "label": "我想聊聊我的狀況", "data": "type=cta&v=consult", "displayText": "我想聊聊我的狀況" }
        }
      ]
    }
  }
}
