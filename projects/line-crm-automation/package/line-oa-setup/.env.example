# LINE Developers Console → Messaging API channel → Channel access token
# 這是機密。不要提交到 git，用完到 Console 撤銷重發。
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Official Account Manager 的帳號 ID（含 @）
LINE_OA_BASIC_ID=@520vqabi

# 瀏覽器自動化用的持久設定檔目錄。第一次執行會開瀏覽器讓你手動登入，
# 之後登入狀態會留在這個資料夾。不要提交到 git。
BROWSER_PROFILE_DIR=./.browser-profile
